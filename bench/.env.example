# Copy to bench/.env. Never commit the key.
GEMINI_API_KEY=
GEMINI_MODEL=
# Maximum USD for one bench run. The runner reads MAX_RUN_COST, then this name.
GEMINI_RUN_COST_CAP_USD=
# paid uses the published standard rate. free uses the published free-tier rate.
GEMINI_PRICE_TIER=paid
# gemini (default) is the paper configuration. ollama runs a local open-weight model for demos only;
# its output goes to bench/results/demo/ and is not a paper result.
LLM_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://127.0.0.1:11434
