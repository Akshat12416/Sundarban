# Copy to contracts/.env. Never commit a private key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
# Optional. When empty, deploy.py grants ISSUER_ROLE to the deployer.
ISSUER_ADDRESS=
# Optional. When empty, Etherscan verification is skipped.
ETHERSCAN_API_KEY=
