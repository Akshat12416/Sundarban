# Copy to services/verifier/.env. Never commit the copy.

FIREBASE_PROJECT_ID=sundarban-a64ea
GOOGLE_APPLICATION_CREDENTIALS=services/verifier/secrets/firebase-admin.json

# disk (default) writes under services/verifier/data/. supabase is the cloud store.
# Firebase Storage is not a valid value.
STORAGE_BACKEND=disk
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# Point the Admin SDK at the emulators. Unset both only when you mean to.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
