# Local evidence files (disk backend). Cloud files live in Supabase.
services/verifier/data/

# Bench photographs. The catalogue bench/data/raw/sources.csv stays tracked.
bench/data/raw/*
!bench/data/raw/sources.csv

# Halves cut from composite photos. Regenerated by bench.generate.
bench/data/derived/*

