# Environment and secrets
.env
.env.*
.env.local
*.local
*/.env
*/.env.*
*/.env.local
!.env.example
!*/.env.example
services/verifier/secrets/


# Vercel & Hosting cache
.vercel/
*/.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
.venv/
venv/
**/__pycache__/
*.py[cod]
