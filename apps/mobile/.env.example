# Copy to apps/mobile/.env. Commit this example only. Never commit the filled file.
# These are the public web-app values from Firebase, not the Admin SDK JSON.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sundarban-a64ea
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# LAN address of the Mac running the verifier. 127.0.0.1 is the phone itself.
EXPO_PUBLIC_VERIFIER_URL=http://127.0.0.1:8000
