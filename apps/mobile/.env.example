# Copy to apps/mobile/.env. Commit this example only. Never commit the filled file.
# Public web-app values from Firebase project sundarban-a64ea. Not the Admin SDK JSON.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sundarban-a64ea
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Verifier on the Mac, reachable from the phone. 127.0.0.1 is the phone itself.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional. Leave empty unless the phone should talk to the Firestore emulator.
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=
