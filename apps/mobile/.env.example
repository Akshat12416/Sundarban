# Copy to apps/mobile/.env. Commit this example only. Never commit the filled file.
# Public web-app values from Firebase project sundarban-a64ea. Not the Admin SDK JSON.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sundarban-a64ea
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Phone must use the Mac's Wi-Fi address. 127.0.0.1 is the phone itself.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Auth emulator host:port. Leave empty only if you mean the live Firebase project.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
# Firestore emulator host:port. The app writes users/{uid} when this is set.
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=
# Web client ID from Firebase Authentication → Google. Android client ID uses the EAS SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
