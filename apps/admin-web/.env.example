# Copy to apps/admin-web/.env. No Firebase Storage bucket.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sundarban-a64ea
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VERIFIER_URL=http://127.0.0.1:8000
# Optional. Set these to the Firebase emulator when the phone app uses it.
# The browser on this machine uses 127.0.0.1. The phone uses the LAN address.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=
